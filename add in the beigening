class Node{
    int data;
    Node next;
    Node(int data){
        this.data=data;
    }
}
class insert{
    Node head=null;
    Node tail=null;
    void ins(int val){
        Node temp=new Node(val);
        if(head==null){
            head=temp;
             tail=temp;
        }
        else{
            temp.next=head;
            head=temp;
        }
       
        
    }
    void display(){
        Node temp=head;
        while(temp!=null){
            System.out.print(temp.data+" ");
            temp=temp.next;
        }
    }
}

public class Main
{
    
	public static void main(String[] args) {
	   insert no=new insert();
	   no.ins(1);
	   no.ins(2);
	   no.ins(3);
	   no.ins(4);
	   no.display();
	}
}
