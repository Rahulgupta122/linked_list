class Node{
    int data;
    Node next;
    Node(int data){
        this.data=data;
    }
}

public class Main
{
    public static void displayr(Node head){
        if(head==null)return;
        System.out.print(head.data+" ");
        displayr(head.next);
        
    }
    public static void displayrev(Node head){
        if(head==null)return;
        displayrev(head.next);
        System.out.print(head.data+" ");

        
    }
    public static int len(Node he){
        int count=0;
        while(he!=null){
            count++;
            he=he.next;
        }
        return count;
    }
	public static void main(String[] args) {
	    Node n1=new Node(1);
	    Node n2=new Node(2);
	    Node n3=new Node(3);
	    Node n4=new Node(4);
	    n1.next=n2;
	    n2.next=n3;
	    n3.next=n4;
	    
	   // displayr(n1);
	   // System.out.println();
	   // displayrev(n1);
	    
	   System.out.print(len(n1));
	}
}
