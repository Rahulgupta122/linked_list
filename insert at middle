class Node{
    int data;
    Node next;
    Node(int data){
        this.data=data;
    }
}
class insert{
    Node head=null;
    Node tail=null;
    void insertatend(int data){
        Node temp=new Node(data);
        if(head==null){
            head=temp;
            tail=temp;
        }
        else{
            tail.next=temp;
            tail=temp;
        }
    }
    void insertatbeg(int data){
         Node temp=new Node(data);
        if(head==null){
            head=temp;
            tail=temp;
        }
        else{
            temp.next=head;
            head=temp;
        }
    }
    int size(){
        Node temp=head;
        int cou=0;
        while(temp!=null){
            cou++;
            temp=temp.next;
        }
        return cou;
    }
    void insertatany(int data,int idx){
        if(idx==size()){
            insertatend(data);
            return;
        }
        else if(idx==0){
            insertatbeg(data);
            return;
        }
        Node temp=head;
        for(int i=1;i<idx-1;i++){
            temp=temp.next;
            
        }
        Node t=new Node(data);
        t.next=temp.next;
        temp.next=t;
        
    }
    void dis(){
        Node temp=head;
        while(temp!=null){
            System.out.print(temp.data+"->");
            temp=temp.next;
        }
    }
}
public class Main
{
	public static void main(String[] args) {
		insert i=new insert();
		i.insertatend(1);
		i.insertatend(2);
		i.insertatend(3);
		i.insertatend(4);
		i.insertatend(5);
		i.dis();
		System.out.println();
		i.insertatbeg(6);
		i.dis();
		System.out.println();
		i.insertatany(7,0);
		i.dis();
		
	}
}
